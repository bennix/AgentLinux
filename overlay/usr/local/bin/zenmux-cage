#!/bin/sh
set -eu
pkg=/opt/claude-cage-package/Cage-0.2.0-rc-linux-amd64.deb
if ! command -v cage-desktop >/dev/null; then
    zenity --question --title="Claude Cage" --text="$(gettext -d agentlinux 'Install the bundled Claude Cage 0.2.0-rc package? Administrator authorization is required.')"
    pkexec /usr/bin/dpkg -i "$pkg" || {
        zenity --error --text="$(gettext -d agentlinux 'Package installation failed. Check the package dependencies in Host Terminal.')"
        exit 1
    }
fi
if ! command -v qemu-system-x86_64 >/dev/null || ! command -v qemu-img >/dev/null || [ ! -d /usr/share/OVMF ]; then
    if zenity --question --title="Claude Cage" --ok-label="$(gettext -d agentlinux 'Install VM tools')" --cancel-label="$(gettext -d agentlinux 'Open workbench only')" --text="$(gettext -d agentlinux 'Local guests require QEMU, OVMF and KVM. Download and install the VM tools?')"; then
        pkexec /usr/bin/apt-get update && pkexec /usr/bin/apt-get install -y qemu-system-x86 qemu-utils ovmf openssh-client iproute2 git || {
            zenity --warning --text="$(gettext -d agentlinux 'VM tools are not fully installed. You can still open the remote workbench.')"
        }
    fi
fi
exec /usr/bin/cage-desktop
