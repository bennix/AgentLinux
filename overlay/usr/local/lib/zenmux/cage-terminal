#!/usr/bin/python3
import os
import subprocess
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Vte", "2.91")
from gi.repository import GLib, Gtk, Pango, Vte

if not os.path.isfile("/usr/bin/claude-cage"):
    os.execl("/usr/local/bin/zenmux-cage", "zenmux-cage")
config = Path(os.environ.get("CLAUDE_CAGE_CONFIG") or Path.home() / ".claude-cage/config.json")
if not config.is_file() or "(no VMs)" in subprocess.run(
    ["/usr/bin/claude-cage", "list"], capture_output=True, text=True
).stdout:
    os.execl("/usr/local/bin/zenmux-cage", "zenmux-cage")

window = Gtk.Window(title="Claude Cage 隔离终端")
window.set_default_size(820, 520)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
term = Vte.Terminal()
term.set_font(Pango.FontDescription("Noto Sans Mono CJK SC 11"))
box.pack_start(term, True, True, 0)
label = Gtk.Label(label="正在连接 Cage…")
setup = Gtk.Button(label="打开 Cage 工作台")
setup.connect("clicked", lambda _: subprocess.Popen(["/usr/local/bin/zenmux-cage"]))
box.pack_end(setup, False, False, 4)
box.pack_end(label, False, False, 4)
window.add(box)
window.connect("destroy", Gtk.main_quit)
term.connect("child-exited", lambda _, status: label.set_text("Cage 会话已结束。可打开工作台查看配置和客机状态。"))
window.show_all()
def spawned(terminal, pid, error, *unused):
    label.set_text(str(error) if error else "Claude Cage 客机终端")
term.spawn_async(Vte.PtyFlags.DEFAULT, None, ["/usr/bin/claude-cage", "shell"], None,
                 GLib.SpawnFlags.DEFAULT, None, None, -1, None, spawned, None)
Gtk.main()
