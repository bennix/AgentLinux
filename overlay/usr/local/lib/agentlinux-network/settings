def load_nodes(button, local):
    source = entry.get_text().strip()
    def worker():
        try:
            try:
                if not local:
                    data, names = backend.nodes(source)
            except (OSError, ValueError):
                if not source.startswith("https://"):
                    raise
                local_fallback = True
            else:
                local_fallback = False
            if local or local_fallback:
                folder = Path.home() / ".local/share/io.github.clash-verge-rev.clash-verge-rev"
                profiles = yaml.safe_load((folder / "profiles.yaml").read_text())
                items = profiles.get("items") or []
                profile = next(i for i in items if (i["uid"] == profiles["current"] if local else i.get("url") == source))
                path = (folder / "profiles" / profile["file"]).resolve()
                if path.parent != (folder / "profiles").resolve():
                    raise ValueError("配置路径无效")
                data = path.read_text()
                with backend.proxy(data) as (names, *_):
                    pass
            GLib.idle_add(loaded, data, names, local or local_fallback)
        except Exception:
            GLib.idle_add(status.set_text, "读取失败。可在 Clash Verge 选中有效订阅，然后读取当前配置。")
        finally:
            GLib.idle_add(button.set_sensitive, True)
    def loaded(data, names, cached):
        imported["data"] = data
        picker.remove_all()
        for name in names:
            picker.append_text(name)
        picker.set_active(0)
        origin = "Clash Verge 本地快照" if cached else "订阅"
        status.set_text(f"已从{origin}读取 {len(names)} 个节点，请选择后连接。")
    button.set_sensitive(False)
    threading.Thread(target=worker, daemon=True).start()


