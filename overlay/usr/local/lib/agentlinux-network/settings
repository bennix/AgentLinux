def test_google(button):
    def check():
        try:
            client = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            with client.open("https://www.google.com/generate_204", timeout=10) as response:
                message = f"Google 连通性测试：HTTP {response.status}"
        except OSError:
            message = "Google 连通性测试失败，请检查连接或更换节点。"
        GLib.idle_add(status.set_text, message)
    threading.Thread(target=check, daemon=True).start()


def change(button, enable):
    try:
        if enable:
            cfg = {"data": imported["data"], "node": picker.get_active_text()} if imported else json.loads((saved if saved.is_file() else config).read_text())
            selection = {"data": cfg["data"], "node": cfg["node"]}
            if not all(selection.values()):
                raise ValueError("请先保存代理节点")
            run("pkexec", "/usr/local/lib/agentlinux-network/configure", input=json.dumps(selection).encode())
            if imported:
                saved.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(mode="w", dir=saved.parent, delete=False) as f:
                    json.dump(selection, f)
                os.replace(f.name, saved)
            active = run("nmcli", "-t", "-f", "UUID", "connection", "show", "--active").stdout.decode().splitlines()
            if uid in active:
                run("pkexec", "/usr/bin/systemctl", "restart", "agentlinux-tunnel.service")
            else:
                run("nmcli", "--wait", "20", "connection", "up", "uuid", uid)
            status.set_text("已启用系统连接：" + cfg["node"] + "。节点不可用时请断开连接恢复直连。")
        else:
            run("nmcli", "--wait", "15", "connection", "down", "uuid", uid)
            status.set_text("系统连接已断开。")
    except (KeyError, ValueError, OSError, subprocess.SubprocessError) as exc:
        status.set_text("操作失败：" + str(exc))

