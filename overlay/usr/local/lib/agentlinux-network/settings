#!/usr/bin/python3
import json
import os
import threading
from pathlib import Path
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

uid = "0e7b6bb9-91e3-46f6-bfc5-00f7c33a7978"
config = Path.home() / ".config/zenmux-agent/settings.json"
window = Gtk.Window(title="系统网络 · 机场代理")
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
box.set_border_width(20)
window.add(box)
status = Gtk.Label(wrap=True)
box.add(Gtk.Label(label="从 ZenMux 助手导入订阅并保存节点后，在此连接。"))
box.add(Gtk.Label(label="连接期间，本机应用默认使用同一节点；关闭连接可恢复网络。"))
box.add(status)


def run(*command, **kwargs):
    return subprocess.run(command, check=True, capture_output=True, **kwargs)


wifi = Gtk.Label(label="正在读取 Wi-Fi 地址…", selectable=True, wrap=True)
box.pack_start(wifi, False, False, 0)
box.reorder_child(wifi, 0)


def wifi_addresses():
    env = dict(os.environ, LC_ALL="C")
    devices = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", text=True, env=env, timeout=4).stdout
    lines = []
    for row in devices.splitlines():
        name, kind, state = row.rsplit(":", 2)
        if kind != "wifi" or not state.startswith("connected"):
            continue
        info = json.loads(run("ip", "-j", "address", "show", "dev", name, text=True, timeout=4).stdout)
        addresses = info[0]["addr_info"] if info else []
        lines.append("Wi-Fi · " + name)
        for family, label in (("inet", "IPv4"), ("inet6", "IPv6")):
            values = [entry["local"] for entry in addresses if entry["family"] == family]
            lines.append(label + "  " + (", ".join(values) or "尚未分配"))
    return "\n".join(lines) or "Wi-Fi 未连接"


def refresh_wifi():
    def read():
        try:
            message = wifi_addresses()
        except (OSError, ValueError, subprocess.SubprocessError):
            message = "暂时无法读取 Wi-Fi 地址，正在重试"
        GLib.idle_add(display, message)
    def display(message):
        wifi.set_text(message)
        GLib.timeout_add_seconds(3, refresh_wifi)
        return False
    threading.Thread(target=read, daemon=True).start()
    return False


refresh_wifi()


def change(button, enable):
    try:
        if enable:
            cfg = json.loads(config.read_text())
            selection = {"data": cfg["data"], "node": cfg["node"]}
            if not all(selection.values()):
                raise ValueError("请先保存代理节点")
            run("pkexec", "/usr/local/lib/agentlinux-network/configure", input=json.dumps(selection).encode())
            active = run("nmcli", "-t", "-f", "UUID", "connection", "show", "--active").stdout.decode().splitlines()
            if uid in active:
                run("pkexec", "/usr/bin/systemctl", "restart", "agentlinux-tunnel.service")
            else:
                run("nmcli", "--wait", "20", "connection", "up", "uuid", uid)
            status.set_text("已启用系统连接：" + cfg["node"] + "。节点不可用时请断开连接恢复直连。")
        else:
            run("nmcli", "--wait", "15", "connection", "down", "uuid", uid)
            status.set_text("系统连接已断开。")
    except (KeyError, ValueError, OSError, subprocess.SubprocessError) as exc:
        status.set_text("操作失败：" + str(exc))

for label, enable in [("使用已保存的节点连接", True), ("断开系统连接", False)]:
    b = Gtk.Button(label=label)
    b.connect("clicked", change, enable)
    box.add(b)
b = Gtk.Button(label="打开 NetworkManager 网络连接列表")
b.connect("clicked", lambda _: subprocess.Popen(["nm-connection-editor"]))
box.add(b)
window.connect("destroy", Gtk.main_quit)
window.show_all()
Gtk.main()
