def measure(button):
    try:
        data = imported.get("data") or json.loads((saved if saved.is_file() else config).read_text())["data"]
    except (OSError, KeyError, ValueError):
        status.set_text(tr('Import a subscription or load your Clash Verge profile first.'))
        return
    previous = picker.get_active_id()
    box.set_sensitive(False)
    status.set_text(tr('Testing each node against Google and ZenMux…'))

    def progress(done, total):
        GLib.idle_add(status.set_text, tr('Testing nodes: {}% ({}/{})').format(done * 100 // total, done, total))

    def finish(rows):
        box.set_sensitive(True)
        if not rows:
            status.set_text(tr('No test results. Check your connection.'))
            return
        # Prefer reliable Google access, then lower median Google latency.
        rows.sort(key=lambda row: (-row[2][0], row[2][1] or float("inf"), -row[1][0], row[1][1] or float("inf")))
        imported["data"] = data
        picker.remove_all()
        def result(sample):
            hits, delay = sample
            return f"{hits}/3 · {delay} ms" if hits else "0/3"
        for name, zenmux, google in rows:
            picker.append(name, f"{name}  |  Google {result(google)}  |  ZenMux {result(zenmux)}")
        if rows[0][2][0]:
            picker.set_active(0)
            status.set_text(tr('The best performing Google node is selected. Apply a routing mode to use it.'))
        else:
            if not previous or not picker.set_active_id(previous):
                picker.set_active(0)
            status.set_text(tr('No node passed the Google test.'))
    def worker():
        try:
            rows = backend.benchmark(data, progress)
        except (OSError, ValueError, subprocess.SubprocessError):
            rows = []
        GLib.idle_add(finish, rows)
    threading.Thread(target=worker, daemon=True).start()


