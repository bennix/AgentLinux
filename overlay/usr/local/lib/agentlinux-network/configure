#!/usr/bin/python3
import fcntl
import json
import os
from pathlib import Path
import sys
import tempfile
import subprocess
import socket
import yaml

if os.geteuid() != 0:
    sys.exit("Requires administrator privileges")
uuid = "0e7b6bb9-91e3-46f6-bfc5-00f7c33a7978"
service = "agentlinux-tunnel.service"
dispatcher = "/etc/NetworkManager/dispatcher.d/84-agentlinux-proxy"
if sys.argv[1:] == ["--direct"]:
    os.environ["CONNECTION_UUID"] = uuid
    os.execv(dispatcher, [dispatcher, "", "ensure-direct"])

raw = sys.stdin.buffer.read(10 * 1024 * 1024 + 1)
if len(raw) > 10 * 1024 * 1024:
    sys.exit("Selection too large")
selection = json.loads(raw)
path = Path("/etc/agentlinux-network/selection.json")
switch = sys.argv[1:] == ["--switch"]
apply = sys.argv[1:] == ["--apply"]
lock = open("/run/agentlinux-network-configure.lock", "a")
fcntl.flock(lock, fcntl.LOCK_EX)
if switch:
    subprocess.run(["systemctl", "is-active", "--quiet", service], check=True)
    previous = path.read_bytes()
    selection["mode"] = json.loads(previous).get("mode", "smart")
selection.setdefault("mode", "smart")
if selection["mode"] not in ("smart", "proxy") or set(selection) != {"node", "data", "mode"} or not all(isinstance(x, str) and x for x in selection.values()):
    sys.exit("Invalid selection")
try:
    profile = yaml.safe_load(selection["data"])
    nodes = profile.get("proxies", []) if isinstance(profile, dict) else []
    for node in nodes:
        if node.get("name") == selection["node"] and isinstance(node.get("server"), str):
            host = node["server"]
            ips = list(dict.fromkeys(x[4][0] for x in socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_STREAM)))
            if ips:
                selection["bootstrap_hosts"] = {host: ips}
            break
except (OSError, ValueError, yaml.YAMLError):
    pass
directory = Path("/etc/agentlinux-network")
directory.mkdir(mode=0o700, exist_ok=True)
def store(content):
    with tempfile.NamedTemporaryFile(dir=directory, delete=False) as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.replace(f.name, path)

def active_connection():
    return uuid in subprocess.check_output(
        ["nmcli", "-g", "UUID", "connection", "show", "--active"], text=True
    ).splitlines()


if apply:
    was_active = active_connection()
    previous = path.read_bytes() if was_active or path.exists() else None

store(json.dumps(selection).encode())
if apply or switch:
    try:
        if switch or was_active:
            subprocess.run(["systemctl", "restart", service], check=True)
        else:
            subprocess.run(["nmcli", "--wait", "20", "connection", "up", "uuid", uuid], check=True)
            subprocess.run(["systemctl", "is-active", "--quiet", service], check=True)
    except subprocess.CalledProcessError:
        if previous is None:
            path.unlink()
        else:
            store(previous)
        if switch or was_active:
            subprocess.run(["systemctl", "restart", service], check=True)
        else:
            if active_connection():
                subprocess.run(["nmcli", "--wait", "15", "connection", "down", "uuid", uuid], check=True)
            subprocess.run([dispatcher, "", "ensure-direct"],
                           env={**os.environ, "CONNECTION_UUID": uuid}, check=True)
        raise
if switch:
    print(selection["mode"])
