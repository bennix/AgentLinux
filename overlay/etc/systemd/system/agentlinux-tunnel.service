[Unit]
Description=AgentLinux host IP tunnel
After=NetworkManager.service
[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=agentlinux-tunnel
RuntimeDirectoryMode=0700
StandardInput=file:/etc/agentlinux-network/selection.json
ExecStart=/usr/local/lib/agentlinux-network/engine
ExecStartPost=+/usr/local/lib/agentlinux-network/ready
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
Restart=on-failure
RestartSec=3
