+{
+    WinTCViewZip* zip = WINTC_VIEW_ZIP(view);
+    gchar* argv[] = {"/usr/bin/engrampa", "--extract", "--",
+                     zip->zip_uri + strlen("file://"), NULL};
+    return g_spawn_async(NULL, argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, error);
+}
+
+static WinTCShextOperation* spawn_zip_operation(WinTCIShextView* view, gint id,
+                                                GList* targets, GError** error)
+{
+    g_list_free(targets);
+    if (id != WINTC_SHEXT_OP_CUSTOM)
+    {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Unknown ZIP operation");
+        return NULL;
+    }
+    WinTCShextOperation* operation = g_new0(WinTCShextOperation, 1);
+    operation->view = view;
+    operation->func = extract_archive;
+    return operation;
+}
