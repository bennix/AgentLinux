msgstr "导入订阅地址"

msgid "Load current Clash Verge profile"
msgstr "读取 Clash Verge 当前配置"

msgid "Import a subscription or load your Clash Verge profile first."
msgstr "请先导入订阅或读取 Clash Verge 当前配置。"

