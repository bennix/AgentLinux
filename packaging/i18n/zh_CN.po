msgid "System Network · Subscription Proxy"
msgstr "系统网络 · 机场代理"

msgid "Enter a subscription URL or load your current Clash Verge profile, then select a node."
msgstr "输入订阅地址，或读取 Clash Verge 当前配置，再选择节点连接。"

msgid "Reading Wi-Fi addresses…"
msgstr "正在读取 Wi-Fi 地址…"

msgid "Not assigned"
msgstr "尚未分配"

