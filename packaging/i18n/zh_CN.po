msgstr "Google 连通性测试失败，请检查连接或更换节点。"

msgid "Save a node first"
msgstr "请先保存代理节点"

msgid "System connection enabled: "
msgstr "已启用系统连接："

msgid ". Disconnect to restore direct access if the node is unavailable."
msgstr "。节点不可用时请断开连接恢复直连。"

