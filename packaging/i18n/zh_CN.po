msgstr "Base URL 需要有效的 HTTPS 地址；本机接口也支持 HTTP"

msgid "Invalid base URL port"
msgstr "Base URL 端口无效"

msgid "Use direct access for local HTTP endpoints"
msgstr "本机 HTTP 接口请使用直连"

msgid "Import and select a proxy node first"
msgstr "请先导入并选择代理节点"

msgid "Provider returned HTTP {}. Check the key, balance, model and tool support."
msgstr "供应商返回 HTTP {}，请检查密钥、余额、模型及工具调用支持"

msgid "Opened home directory"
msgstr "已打开主目录"

msgid "Enter a single valid directory name"
msgstr "文件夹名称必须是单个有效目录名"

