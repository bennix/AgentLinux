msgstr "直连（关闭系统隧道）"

msgid "Test Google connectivity"
msgstr "测试 Google 连接"

msgid "Open NetworkManager connections"
msgstr "打开 NetworkManager 网络连接列表"

msgid "ZenMux Desktop Assistant"
msgstr "ZenMux 桌面助手"

msgid "Respond in English. Use the available tools when the user requests desktop actions."
msgstr "使用中文回答。用户要求桌面操作时可调用可用工具。"

msgid "Assistant"
msgstr "助手"

msgid "Settings"
msgstr "设置"

msgid "Ask a question or describe a desktop action"
msgstr "输入问题，或描述桌面操作"

