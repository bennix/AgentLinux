#!/usr/bin/python3
from gettext import dgettext
from functools import partial
tr = partial(dgettext, 'agentlinux')
"""Configure Cage using the local user's currently active Clash Verge profile."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time
import yaml

def dialog(*args):
    return subprocess.run(["zenity", tr('--title=Claude Cage · Proxy Settings'), *args],
                          capture_output=True, text=True)

def call(op, payload=None):
    cmd = ["claude-cage", "agent", "call", op]
    with tempfile.NamedTemporaryFile(mode="w", dir=os.environ.get("XDG_RUNTIME_DIR")) as f:
        if payload is not None:
            json.dump(payload, f)
            f.flush()
            cmd.extend(["--input", f.name])
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=40)
    result = json.loads(proc.stdout)
    if result.get("status") not in ("completed", "accepted"):
        raise ValueError(tr('Create or unlock your local Cage account, then reopen proxy settings.'))
    return result["data"]

def apply(op, payload):
    job = call(op, payload)
    if not job.get("id"):
        return
    for _ in range(60):
        latest = call("status").get("job") or {}
        if latest.get("id") != job["id"]:
            raise ValueError(tr('The active job changed. Check its status in the workbench.'))
        if not latest.get("running"):
            if latest.get("error"):
                raise ValueError(tr('Cage could not apply the configuration. Check the node in the workbench.'))
            return
        time.sleep(1)
    raise ValueError(tr('Operation still running. Check progress in the workbench.'))

def main():
    sources = call("proxy.status").get("sources") or []
    if not any(s.get("nodes") for s in sources):
        folder = Path.home()/".local/share/io.github.clash-verge-rev.clash-verge-rev"
        config = folder/"profiles.yaml"
        if not config.exists():
            raise ValueError(tr('Import and select a subscription in Clash Verge, then copy its nodes here.'))
        profiles = yaml.safe_load(config.read_text()) or {}
        item = next((i for i in profiles.get("items") or [] if i["uid"] == profiles.get("current")), None)
        if not item:
            raise ValueError(tr('Select a profile in Clash Verge first.'))
        base = (folder/"profiles").resolve()
        path = (base/item["file"]).resolve()
        if path.parent != base or not path.is_file():
            raise ValueError(tr('The active profile file is missing.'))
        if dialog("--question",tr('--text=Copy nodes from your current Clash Verge profile into Cage? This makes a local snapshot. Import it again after subscription updates.')).returncode:
            return
        apply("proxy.import", {"name": tr('Local Clash Verge profile'), "content":path.read_text()})
        sources = call("proxy.status").get("sources") or []
    choices = [(s,n) for s in sources for n in s.get("nodes") or []]
    if not choices:
        raise ValueError(tr('This profile has no nodes that Cage can use.'))
    args = ["--list",tr('--text=Select a node for installing the guest'),tr('--column=Number'),tr('--column=Node'),tr('--column=Type'),"--height=420"]
    for i, (_, node) in enumerate(choices, 1):
        args.extend([str(i),node["name"],node["type"]])
    result = dialog(*args)
    if result.returncode:
        return
    source,node = choices[int(result.stdout.strip())-1]
    apply("proxy.select", {"id":source["id"],"node_id":node["id"]})
    status = call("proxy.status")
    if not status.get("running") or not status.get("selected"):
        raise ValueError(tr('The node has not started. Check proxy status in the workbench.'))
    dialog("--info",tr('--text=Node applied and proxy started. Return to the Cage workbench to install the guest.'))

if __name__ == "__main__":
    try:
        main()
    except ValueError as exc:
        dialog("--error","--text="+(str(exc) if type(exc) is ValueError else tr('Cannot read the local profile. Check the workbench.')))
    except (KeyError, IndexError, OSError, subprocess.SubprocessError, yaml.YAMLError):
        dialog("--error",tr('--text=Cannot read the profile or contact Cage. Open the workbench and sign in first.'))
