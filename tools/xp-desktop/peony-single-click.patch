+static bool singleClickDesktop()
+{
+    const QString config = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation);
+    return QFileInfo::exists(config + QStringLiteral("/agentlinux-xp/explorer-single-click"));
+}
+
 void DesktopIconView::initDoubleClick()
 {
+    connect(this, &QListView::clicked, this, [this](const QModelIndex &index) {
+        if (singleClickDesktop() && QApplication::keyboardModifiers() == Qt::NoModifier &&
+            !style()->styleHint(QStyle::SH_ItemView_ActivateItemOnSingleClick, nullptr, this))
+            openFileByUri(index.data(FileItemModel::UriRole).toString());
+    });
     connect(this, &QListView::activated, this, [=](const QModelIndex &index) {
