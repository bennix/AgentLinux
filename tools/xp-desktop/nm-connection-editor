#!/usr/bin/python3
"""Extend the installed NetworkManager proxy page with the system-wide settings link."""
import os
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

from gi.repository import GLib

editor = "/usr/bin/nm-connection-editor"
prefix = "/org/gnome/nm_connection_editor"
resource = "nm-connection-editor.ui"
env = os.environ.copy()
with tempfile.TemporaryDirectory(prefix="agentlinux-nm-") as directory:
    try:
        ui = ET.fromstring(subprocess.check_output(["gresource", "extract", editor, prefix + "/" + resource]))
        footer = ui.find(".//object[@id='hbox1']")
        if footer is not None:
            child = ET.Element("child")
            footer.insert(next(i for i, element in enumerate(footer) if element.tag == "child"), child)
            link = ET.SubElement(child, "object", {"class": "GtkLinkButton", "id": "agentlinux_system_network"})
            label = ("系统网络 · 机场代理…" if GLib.get_language_names()[0].startswith("zh")
                     else "System Network · Subscription Proxy…")
            for name, value in (("visible", "True"), ("halign", "start"), ("label", label),
                                ("uri", "agentlinux-network:settings")):
                ET.SubElement(link, "property", name=name).text = value
            ET.ElementTree(ui).write(Path(directory) / resource, encoding="utf-8")
            env["G_RESOURCE_OVERLAYS"] = os.pathsep.join(filter(None, (
                prefix + "=" + directory, env.get("G_RESOURCE_OVERLAYS"))))
    except (OSError, ValueError, ET.ParseError, subprocess.CalledProcessError) as error:
        print(error, file=sys.stderr)
    sys.exit(subprocess.call([editor, *sys.argv[1:]], env=env))
